# Closest Wins — environment variables. PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.
#
# With NOTHING set, the app runs in LOCAL MODE: an embedded Postgres (PGlite) under .data/,
# a signed-cookie guest identity, and clearly-labeled demo questions. Local mode refuses to run on Vercel.

# --- Branding ---------------------------------------------------------------
NEXT_PUBLIC_GAME_TITLE="Closest Wins"
# Challenge #1 date (America/New_York calendar date)
NEXT_PUBLIC_GAME_LAUNCH_DATE=2026-11-01
# Public URL used in share text (optional; defaults to the current origin)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Supabase (required for deployment) -------------------------------------
# Project Settings → API. The publishable (anon) key is safe in the browser: every table has RLS
# enabled with no policies and no grants, so it can only be used for Auth.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Server-only Postgres connection. Use the *transaction pooler* string (port 6543) for Vercel.
# Project Settings → Database → Connection string → Transaction pooler.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: Supabase's database CA certificate (PEM, "\n" escaped) for full TLS verification.
# Without it, the connection is encrypted but the server certificate is not verified.
DATABASE_CA_CERT=
# Optional: max connections per serverless instance (default 1, as Supabase recommends for serverless)
DATABASE_POOL_MAX=1

# --- Scheduled jobs ---------------------------------------------------------
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=replace-with-a-long-random-string

# --- AI question generation (optional) --------------------------------------
# Without a key, generation is disabled and the admin UI says so. Nothing else is affected.
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5 (cheapest; ~$2–4/month at full daily replenishment).
# claude-sonnet-5-5 (~10–20x more) or claude-opus-5-5 (~40x more) research more thoroughly.
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Content safety switch --------------------------------------------------
# Demo questions are UNVERIFIED. They are only schedulable when this is true.
# Defaults to true in local mode and false when Supabase is configured.
ALLOW_DEMO_CONTENT=false

# --- Local development only -------------------------------------------------
# Enables the /admin password login in local mode (ignored when Supabase is configured or on Vercel).
LOCAL_ADMIN_PASSWORD=choose-a-local-password
# Signs the local guest cookie and salts rate-limit IP hashes. Set any long random string.
LOCAL_SESSION_SECRET=replace-with-a-long-random-string
# Embedded database location (or memory:// for a throwaway database)
LOCAL_DB_DIR=.data/pglite
